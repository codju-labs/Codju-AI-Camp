---
import { getCollection, render } from "astro:content";
import PortalLayout from "../../../layouts/PortalLayout.astro";
import { LessonContainer } from "../../../components/learning/LessonContainer";
import { allCampLevels } from "../../../lib/campContent";

const campLevelIds = allCampLevels.map((level) => level.id);

export async function getStaticPaths() {
  const campLevelIds = allCampLevels.map((level) => level.id);
  const levels = await getCollection("levels");
  return levels
    .filter((level) => campLevelIds.includes(level.id))
    .map((level) => ({
      params: { id: level.id },
      props: { level },
    }));
}

const { level } = Astro.props;
const { Content } = await render(level);
---

<PortalLayout title={level.data.title} showHeader={false}>
  <LessonContainer
    client:load
    levelId={level.id}
    levelTitle={level.data.title}
    sectionCount={level.data.sectionCount}
  >
    <Content />
  </LessonContainer>
</PortalLayout>
