---
import { getCollection, render } from "astro:content";
import PortalLayout from "../../../layouts/PortalLayout.astro";
import { LessonContainer } from "../../../components/learning/LessonContainer";
import { allOpenLevels } from "../../../lib/campContent";

const openLevelIds = allOpenLevels.map((level) => level.id);

export async function getStaticPaths() {
  const openLevelIds = allOpenLevels.map((level) => level.id);
  const levels = await getCollection("levels");
  return levels
    .filter((level) => openLevelIds.includes(level.id))
    .map((level) => ({
      params: { id: level.id },
      props: { level },
    }));
}

const { level } = Astro.props;
const currentIndex = openLevelIds.indexOf(level.id);
const nextLevelId = openLevelIds[currentIndex + 1] ?? null;
const { Content } = await render(level);
---

<PortalLayout title={level.data.title} showHeader={false}>
  <LessonContainer
    client:load
    levelId={level.id}
    levelTitle={level.data.title}
    sectionCount={level.data.sectionCount}
    nextLevelId={nextLevelId}
  >
    <Content />
  </LessonContainer>
</PortalLayout>
