{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "codju-ai-creator-camp",
	"main": "worker/index.js",
	"compatibility_date": "2026-06-09",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".site",
			"binding": "ASSETS",
			"run_worker_first": [
				"/api/*",
				"/payment/*",
				"/learn",
				"/learn/*",
				"/portfolio",
				"/portfolio/*"
			]
	},
		"vars": {
			"CCAVENUE_ENVIRONMENT": "production",
			"REGISTRATION_STATUS": "closed",
			"PUBLIC_SITE_URL": "https://summercamp.codju.com/",
			"ACCESS_TEST_EMAILS": "devashishpuri@gmail.com, rkbish@gmail.com, bhavishyasingla2005@gmail.com, sksudheerkumar1@gmail.com, rd.shyam@gmail.com, kavitarathore0289@gmail.com, harshitrathore067@gmail.com, bishnoi.anamika229@gmail.com, rambhoyadav@gmail.com, sanjeev.kaler55@gmail.com, shubhamgarg.ece93@gmail.com, shivaanagarwal1@gmail.com, speakhimanshu@gmail.com, mani.codju@gmail.com, palak.codju@gmail.com"
		},
	"d1_databases": [
		{
			"binding": "PAYMENTS",
			"database_name": "codju-camp-payments",
			"database_id": "0fd4579b-8073-46cc-b0e3-7d8c779a20b8"
		}
	],
	"r2_buckets": [
		{
			"binding": "PORTFOLIO_ASSETS",
			"bucket_name": "codju-camp-portfolio-assets"
		}
	],
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	}
}
